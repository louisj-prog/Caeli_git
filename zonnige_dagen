# Dit script doet het volgende:
    
# Het laad de complete MODIS dataset in van de maand Juli.
# Vervolgens maken we een kolom aan van orbit (en later satelliet)
# Hierna kijken per orbit of het een onbewolkte dag is ja of nee.

import pandas as pd

#Data inladen
MODIS_Juli = pd.read_csv('MODIS_Juli.csv')

# Hier splitten per orbit
MODIS_Juli['idx_utc'] = pd.to_datetime(MODIS_Juli['idx_utc'])

# Functie om per dag de unieke tijdstippen te nummeren als orbit
fn = lambda g: g.assign(
    orbit_nr=pd.factorize(g['idx_utc'])[0] + 1,
    orbit=g['datum'].astype(str) + '_orbit_' + (pd.factorize(g['idx_utc'])[0] + 1).astype(str)
)

# Pas dit toe per dag
MODIS_Juli = MODIS_Juli.groupby('datum', group_keys=False).apply(fn)

# Bekijk het resultaat
print(MODIS_Juli[['datum', 'idx_utc', 'orbit']].head(10))

