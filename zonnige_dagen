import pandas as pd

# Laad de dataset in
df = pd.read_csv('mcd19a2_juli_2026.csv')

#per dag
df['timestamp'] = pd.to_datetime(df['datum'])
df['alleen_datum'] = df['timestamp'].dt.date


df['is_wolkenvrij'] = df['optical_depth_055'].notnull()

# 4. Groepeer de data per dag en tel de metingen
dag_overzicht = df.groupby('alleen_datum').agg(
    totale_passages=('is_wolkenvrij', 'count'),          
    aantal_zonnige_metingen=('is_wolkenvrij', 'sum')     
).reset_index()

# We maken een grenswaarde van per dag 
grenswaarde_zonnige_metingen = 200000 


dag_overzicht['is_zonnige_dag'] = dag_overzicht['aantal_zonnige_metingen'] > grenswaarde_zonnige_metingen
print(dag_overzicht)
dag_overzicht.to_csv('dagen_zonnig_of_niet.csv', index=False)
print("\nDe analyse is voltooid en opgeslagen als 'dagen_zonnig_of_niet.csv'.")
